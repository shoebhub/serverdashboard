# ============================================
# Proxmox Infrastructure Dashboard - Configuration
# ============================================
# Copy this file to server/.env and update the values

# --- Proxmox Node 1 ---
PROXMOX_NODE1_HOST=https://192.168.1.101:8006
PROXMOX_NODE1_TOKEN_ID=root@pam!dashboard
PROXMOX_NODE1_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PROXMOX_NODE1_NAME=Node-1

# --- Proxmox Node 2 ---
PROXMOX_NODE2_HOST=https://192.168.1.102:8006
PROXMOX_NODE2_TOKEN_ID=root@pam!dashboard
PROXMOX_NODE2_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PROXMOX_NODE2_NAME=Node-2

# --- Proxmox Node 3 ---
PROXMOX_NODE3_HOST=https://192.168.1.103:8006
PROXMOX_NODE3_TOKEN_ID=root@pam!dashboard
PROXMOX_NODE3_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PROXMOX_NODE3_NAME=Node-3

# --- Backend Server ---
PORT=4000
JWT_SECRET=change-this-to-a-strong-random-secret-key
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# --- Mode ---
# Set to 'demo' to use simulated data, 'live' to connect to real Proxmox servers
MODE=demo
